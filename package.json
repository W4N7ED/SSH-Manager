{
  "name": "ssh-manager",
  "version": "1.3.0",
  "description": "SSH/FTP/SFTP Connection Manager for Windows 11",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:icon": "node scripts/convert-icon.js",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:icon && npm run build:renderer && electron-builder --win",
    "build:portable": "npm run build:icon && npm run build:renderer && electron-builder --win portable",
    "pack": "npm run build:icon && npm run build:renderer && electron-builder --win --dir"
  },
  "overrides": {
    "rimraf": "^5.0.10",
    "tar": "^7.4.3",
    "glob": "^10.4.5",
    "npmlog": "^7.0.1",
    "gauge": "^5.0.2",
    "are-we-there-yet": "^4.0.0"
  },
  "build": {
    "appId": "com.sshmanager.app",
    "productName": "SSH Manager",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SSH Manager",
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/renderer/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md"
    ]
  },
  "dependencies": {
    "basic-ftp": "^6.0.1",
    "bip39": "^3.1.0",
    "electron-store": "^8.2.0",
    "ssh2": "^1.16.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1"
  }
}
